{
  "name": "nibhrito",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:web": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:list:local": "wrangler d1 migrations list DB --local",
    "worker:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run test:e2e && npm run worker:check && npm audit --audit-level=low",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.116.0"
  }
}
