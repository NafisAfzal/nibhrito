{
  "name": "nibhrito",
  "description": "Privacy-focused anonymous feedback with browser-side end-to-end encryption.",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NafisAfzal/nibhrito.git"
  },
  "bugs": {
    "url": "https://github.com/NafisAfzal/nibhrito/issues"
  },
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "npm run local:init && npm run db:migrate:local && npm run build && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "local:init": "node scripts/init-local.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:worker": "npm run local:init && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && npm run test:artifacts && playwright test",
    "test:edge": "npm run build && npm run test:artifacts && playwright test --config playwright.edge.config.ts",
    "test:artifacts": "node scripts/e2e-artifact-check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:list:local": "wrangler d1 migrations list DB --local",
    "worker:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "privacy:check": "node scripts/privacy-check.mjs",
    "repository:check": "node scripts/repository-check.mjs",
    "test:repository": "node --test scripts/repository-check.test.mjs",
    "check": "npm run lint && npm run format:check && npm run privacy:check && npm run build && npm test && npm run test:e2e && npm run worker:check && npm audit --audit-level=low",
    "production:init": "node scripts/configure-production.mjs",
    "production:secret": "node scripts/init-production-secret.mjs",
    "db:portability": "vitest run tests/integration/portability.test.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.116.0"
  }
}
